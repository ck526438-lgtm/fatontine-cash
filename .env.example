# Copiez ce fichier en .env puis remplissez les valeurs. Ne publiez JAMAIS le fichier .env.
DJANGO_DEBUG=0
# Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_ALLOWED_HOSTS=fatontine.ci,www.fatontine.ci
DJANGO_CSRF_TRUSTED_ORIGINS=https://fatontine.ci,https://www.fatontine.ci

# PostgreSQL
DATABASE_URL=postgres://fatontine:mot-de-passe@localhost:5432/fatontine
DATABASE_SSLMODE=prefer

# Pièces d'identité (dossier privé, hors du dossier web) et sauvegardes
PRIVATE_MEDIA_ROOT=/var/lib/fatontine/private_media
BACKUP_DIR=/var/backups/fatontine

# E-mail (réinitialisation du mot de passe)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=FATONTINE CASH <no-reply@fatontine.ci>

# Protection connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
